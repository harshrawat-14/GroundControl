# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=groundcontrol
POSTGRES_USER=groundcontrol
POSTGRES_PASSWORD=groundcontrol
DATABASE_URL=postgresql+asyncpg://groundcontrol:groundcontrol@localhost:5432/groundcontrol

# Redis (semantic cache + ARQ queue)
REDIS_URL=redis://localhost:6379/0

# LLM providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloud adapter (pick one; leave blank to stay local-only)
CLOUD_PROVIDER=              # bedrock | vertex | ""
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL_ID=

# Embeddings
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Agent loop
MAX_ITERATIONS=3
FAITHFULNESS_THRESHOLD=0.75
GROUNDEDNESS_THRESHOLD=0.75

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
PROMETHEUS_ENABLED=true

# API
API_KEY=changeme
LOG_LEVEL=INFO
